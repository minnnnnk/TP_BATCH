# ── TourAPI ─────────────────────────────────────────────
# 공공데이터포털에서 발급받은 "디코딩" 서비스키
TOUR_API_SERVICE_KEY=YOUR_DECODING_SERVICE_KEY_HERE
TOUR_API_MOBILE_APP=TP_BATCH2
TOUR_API_TIMEOUT_SEC=20

# ── PostgreSQL ──────────────────────────────────────────
# 팀 공용 DB 호스트. 기본값 없음 — 비워두면 실행 즉시 실패한다.
DB_HOST=
DB_PORT=5432
DB_NAME=aidb
DB_USER=aiadmin
DB_PASSWORD=

# ── 배치 설정 ───────────────────────────────────────────
BATCH_NUM_OF_ROWS=100     # 페이지당 결과 수
BATCH_MAX_PAGES=20        # 1회 실행당 최대 페이지 수 (일일 호출 한도 보호)
BATCH_CHUNK_SIZE=500      # DB 적재 묶음 크기

# ── 일일 호출 한도 / 스케줄 (daily, schedule) ───────────
# 서비스(KorService2, PhotoGalleryService1)별 하루 상한. 개발계정 1,000건 중 여유분을 남긴다.
TOUR_API_DAILY_LIMIT=900
DAILY_CRON=0 4 * * *          # 한국 시간 crontab (기본 매일 04:00)
DAILY_REFRESH_MAX_PAGES=10    # 최근 수정분 갱신에 쓸 최대 페이지 수
DAILY_GALLERY_MAX_PAGES=70

# ── 상세정보 보강 (enrich, B-10) ────────────────────────
DETAIL_WITH_OVERVIEW=true             # 개요·신분류코드도 받기 (장소당 호출 2회, false면 1회)
DETAIL_PRIORITY_TYPES=12,14,39,28,38  # 먼저 채울 관광타입
# 먼저 채울 지역코드 (예: 32,39). 비워 두면 전국
DETAIL_PRIORITY_AREAS=

# ── 임베딩 (sync 잡) ────────────────────────────────────
# TP_TRAVEL_AI와 반드시 동일하게 유지할 것. 다르면 벡터를 서로 비교할 수 없다.
EMBEDDING_MODEL_NAME=jhgan/ko-sroberta-multitask
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# ── 선택: 기존 Kotlin 배치 설정 재사용 ──────────────────
# 아래 경로를 지정하면 secrets.properties의 서비스키/DB 정보를 그대로 읽는다.
# SECRETS_PROPERTIES=/path/to/TP_BATCH/secrets.properties
