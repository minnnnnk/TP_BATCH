# ========================================================
# API 키 전용 시크릿 파일 템플릿
# ========================================================
# 이 파일을 복사하여 'secrets-api.properties' 파일을 만들고 실제 API 키를 입력하세요.
# 'secrets-api.properties'는 .gitignore 에 등록되어 Git에 커밋되지 않습니다.
#
# DB 접속 정보(secrets.properties)와 분리하여 API 키만 별도로 격리 관리합니다.
# ========================================================

# 한국관광공사 TourAPI (공공데이터포털 data.go.kr) 일반 인증키 (Decoding 키)
tour.api.serviceKey=YOUR_TOUR_API_DECODING_KEY_HERE

# 기상청 API 허브 (apihub.kma.go.kr) 발급 authKey
kma.api.authKey=YOUR_KMA_AUTH_KEY_HERE
