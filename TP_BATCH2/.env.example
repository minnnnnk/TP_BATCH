# ── TourAPI ─────────────────────────────────────────────
# 공공데이터포털에서 발급받은 "디코딩" 서비스키
TOUR_API_SERVICE_KEY=YOUR_DECODING_SERVICE_KEY_HERE
TOUR_API_MOBILE_APP=TP_BATCH2
TOUR_API_TIMEOUT_SEC=20

# ── PostgreSQL ──────────────────────────────────────────
# 팀 공용 DB 호스트. 기본값 없음 — 비워두면 실행 즉시 실패한다.
DB_HOST=
DB_PORT=5432
DB_NAME=aidb
DB_USER=aiadmin
DB_PASSWORD=

# ── 배치 설정 ───────────────────────────────────────────
BATCH_NUM_OF_ROWS=100     # 페이지당 결과 수
BATCH_MAX_PAGES=20        # 1회 실행당 최대 페이지 수 (일일 호출 한도 보호)
BATCH_CHUNK_SIZE=500      # DB 적재 묶음 크기

# ── 임베딩 (sync 잡) ────────────────────────────────────
# TP_TRAVEL_AI와 반드시 동일하게 유지할 것. 다르면 벡터를 서로 비교할 수 없다.
EMBEDDING_MODEL_NAME=jhgan/ko-sroberta-multitask
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# ── 선택: 기존 Kotlin 배치 설정 재사용 ──────────────────
# 아래 경로를 지정하면 secrets.properties의 서비스키/DB 정보를 그대로 읽는다.
# SECRETS_PROPERTIES=/path/to/TP_BATCH/secrets.properties
